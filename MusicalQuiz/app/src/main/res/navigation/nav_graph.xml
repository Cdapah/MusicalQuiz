<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.musicquiz.ui.search.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_detailsFragment"
            app:destination="@id/detailsFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.musicquiz.ui.details.DetailsFragment"
        android:label="Details"
        tools:layout="@layout/fragment_details">
        <argument
            android:name="itemId"
            app:argType="string" />
        <argument
            android:name="itemType"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.example.musicquiz.ui.playlist.PlaylistFragment"
        android:label="Playlists"
        tools:layout="@layout/fragment_playlist">
        <action
            android:id="@+id/action_playlistFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizFragment"
        android:name="com.example.musicquiz.ui.quiz.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz">
        <action
            android:id="@+id/action_quizFragment_to_quizPlayFragment"
            app:destination="@id/quizPlayFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizPlayFragment"
        android:name="com.example.musicquiz.ui.quiz.QuizPlayFragment"
        android:label="Play Quiz"
        tools:layout="@layout/fragment_quiz_play">
        <argument
            android:name="quizId"
            app:argType="long" />
    </fragment>
</navigation>
